# 当前运行环境，可选 development、test、production
NODE_ENV=development

# OpenAI API 密钥，使用 OpenAI 模型或嵌入时需要配置
OPENAI_API_KEY=

# 大语言模型提供方，默认 openai；可切换为 ollama 使用本地模型
LLM_PROVIDER=openai

# Ollama 本地服务地址，仅在 LLM_PROVIDER=ollama 时使用
OLLAMA_BASE_URL=http://localhost:11434

# 向量嵌入提供方，默认 openai；可切换为 local-ollama 使用本地嵌入模型
EMBEDDING_PROVIDER=openai

# Fastify API 服务监听端口
API_PORT=3001

# 前端访问后端 API 的基础地址，Next.js rewrites 会使用该地址代理 /api 请求
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# PostgreSQL 连接字符串，用于存储用户、会话和文档元数据
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag

# Docker PostgreSQL 初始化用户名
POSTGRES_USER=rag

# Docker PostgreSQL 初始化密码，仅用于本地开发
POSTGRES_PASSWORD=rag

# Docker PostgreSQL 初始化数据库名
POSTGRES_DB=rag

# Redis 连接地址，用于缓存、会话和 BullMQ 队列
REDIS_URL=redis://localhost:6379

# Qdrant 向量数据库 REST 地址
QDRANT_URL=http://localhost:6333

# BullMQ 文档处理队列名称，API 和 Worker 必须保持一致
DOCUMENT_QUEUE_NAME=documents

# 本地上传文件暂存目录
UPLOAD_DIR=uploads
